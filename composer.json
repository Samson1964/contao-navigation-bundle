{
    "name": "schachbulle/contao-navigation-bundle",
    "type": "contao-bundle",
    "description": "Frontend-Module für eine gemeinsame Navigation über Seiten und Artikel.",
    "keywords": [
        "contao",
        "navigation",
        "seiten",
        "artikel",
        "inserttag"
    ],
    "homepage": "https://github.com/Samson1964/contao-navigation-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Binding",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.0",
        "contao/core-bundle": "^4.13 || ^5.0",
        "symfony/config": "^5.4 || ^6.0 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoNavigationBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoNavigationBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoNavigationBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-navigation-bundle/issues",
        "source": "https://github.com/Samson1964/contao-navigation-bundle"
    }
}
